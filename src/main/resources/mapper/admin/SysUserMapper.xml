<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.web.project.admin.mapper.SysUserMapper">

    <!-- 凭据查询需要密码密文；列表查询使用下方的安全字段集。 -->
    <sql id="SysUserColumns">
        id,
        username,
        password,
        nickname,
        status,
        created_at,
        updated_at
    </sql>

    <!-- 系统用户列表不读取密码密文。 -->
    <sql id="SysUserSafeColumns">
        id,
        username,
        nickname,
        status,
        created_at,
        updated_at
    </sql>

    <!-- 账号或昵称模糊搜索；未提供状态时查询全部状态。 -->
    <sql id="SysUserConditions">
        <where>
            <if test="keyword != null and keyword != ''">
                AND (
                username LIKE CONCAT('%', #{keyword}, '%')
                OR nickname LIKE CONCAT('%', #{keyword}, '%')
                )
            </if>

            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
    </sql>

    <!-- 根据登录账号查询系统用户 -->
    <select id="selectByUsername"
            resultType="com.web.project.admin.entity.SysUser">
        SELECT
        <include refid="SysUserColumns"/>
        FROM sys_user
        WHERE username = #{username}
        LIMIT 1
    </select>

    <!-- 根据 ID 查询系统用户 -->
    <select id="selectById"
            resultType="com.web.project.admin.entity.SysUser">
        SELECT
        <include refid="SysUserColumns"/>
        FROM sys_user
        WHERE id = #{id}
        LIMIT 1
    </select>

    <!-- 查询符合条件的数据总数 -->
    <select id="countByCondition"
            resultType="long">
        SELECT COUNT(*)
        FROM sys_user
        <include refid="SysUserConditions"/>
    </select>

    <!-- 分页查询系统用户列表 -->
    <select id="selectPageByCondition"
            resultType="com.web.project.admin.entity.SysUser">
        SELECT
        <include refid="SysUserSafeColumns"/>
        FROM sys_user
        <include refid="SysUserConditions"/>
        ORDER BY id DESC
        LIMIT #{offset}, #{pageSize}
    </select>

</mapper>
